# ==============================================================================
# Variáveis de Ambiente para Vercel (Project Settings -> Environment Variables)
# ==============================================================================

# 1. Token de Acesso Pessoal do GitHub (escopo: apenas "gist")
GITHUB_SYNC_TOKEN=seu_github_token_aqui

# 2. Identificador do novo Gist Secreto criado em https://gist.github.com
# O identificador é o código alfanumérico que aparece no final do URL do seu Gist
GIST_ID=id_do_seu_novo_gist_secreto_aqui

# 3. Segredo para exigir autenticação nas rotas de sincronização (/api/sync)
SYNC_API_SECRET=uma_chave_secreta_forte_e_aleatoria

# 4. Mesma chave secreta para o frontend enviar automaticamente ao sincronizar
VITE_SYNC_API_SECRET=uma_chave_secreta_forte_e_aleatoria

# (Opcional) Origens permitidas para CORS (separadas por vírgula)
# ALLOWED_ORIGIN=https://sernic-drh2026-seven.vercel.app
