# Exemplo de Variáveis de Ambiente para Vercel
# Configure estas variáveis nas definições do projeto na Vercel (Project Settings -> Environment Variables)

# Token do GitHub com permissão apenas para Gist (Personal Access Token)
GITHUB_SYNC_TOKEN=seu_novo_token_aqui

# (Opcional) Chave secreta para proteger as rotas de sincronização contra acessos não autorizados
# SYNC_API_SECRET=seu_segredo_de_sincronizacao

# (Opcional) ID do Gist se desejar alterar o repositório de sincronização
# GIST_ID=dd985f35807d842a90cc097c26c07e47

# (Opcional) Origens permitidas para CORS (separadas por vírgula)
# ALLOWED_ORIGIN=https://seu-dominio.vercel.app
