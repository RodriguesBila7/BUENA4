@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');

:root {
  /* Font Family */
  --font-family: 'Inter', system-ui, -apple-system, sans-serif;

  /* Temas e Cores Dinâmicas (Serão sobrescritas via inline JS no Super Admin) */
  --color-primary: #1B365D;    /* Azul Institucional padrão */
  --color-secondary: #2D3748;  /* Cinza Escuro padrão */
  --color-accent: #FFFFFF;     /* Branco de Destaque padrão */

  /* Cores de Fundo e Texto do Modo Claro (invertidas: base ↔ card) */
  --color-bg-base: #FFFFFF;
  --color-bg-card: #F8FAFC;
  --color-bg-sidebar: #1E293B; /* Sidebar sempre escura para contraste institucional */
  --color-sidebar-text: #F8FAFC;
  --color-sidebar-text-muted: #94A3B8;
  --color-text-base: #0F172A;
  --color-text-muted: #475569;
  --color-text-light: #64748B;
  --color-border: #E2E8F0;
  --color-border-hover: #CBD5E1;
  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  --shadow-glow: 0 0 15px rgba(27, 54, 93, 0.15);
  
  /* Sistema de Alertas */
  --color-success: #10B981;
  --color-warning: #F59E0B;
  --color-danger: #EF4444;
  --color-info: #3B82F6;
  
  --transition-fast: 0.15s ease;
  --transition-normal: 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  --radius-sm: 6px;
  --radius-md: 10px;
  --radius-lg: 16px;
}

/* Modo Escuro (Aplicado ao body ou html via classe ou data-attribute) */
[data-theme="dark"] {
  --color-bg-base: #1E293B;
  --color-bg-card: #0F172A;
  --color-text-base: #F8FAFC;
  --color-text-muted: #94A3B8;
  --color-text-light: #64748B;
  --color-border: #334155;
  --color-border-hover: #475569;
  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.3), 0 2px 4px -1px rgba(0, 0, 0, 0.2);
  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.4), 0 4px 6px -2px rgba(0, 0, 0, 0.3);
  --shadow-glow: 0 0 20px rgba(255, 255, 255, 0.05);
}

/* Estilos Globais */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: var(--font-family);
  /* background-color gerida dinamicamente pelo Login ou Dashboard */
  color: var(--color-text-base);
  min-height: 100vh;
  transition: background-color var(--transition-normal), color var(--transition-normal);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

button, input, select, textarea {
  font-family: inherit;
}

button {
  cursor: pointer;
  transition: transform var(--transition-fast), filter var(--transition-fast), box-shadow var(--transition-fast), opacity var(--transition-fast);
}

button:hover:not(:disabled) {
  transform: translateY(-1px);
  filter: brightness(0.95);
}

button:active:not(:disabled) {
  transform: translateY(1px);
  filter: brightness(0.9);
}

[data-theme="dark"] button:hover:not(:disabled) {
  filter: brightness(1.15);
}

[data-theme="dark"] button:active:not(:disabled) {
  filter: brightness(1.05);
}

a {
  color: var(--color-primary);
  text-decoration: none;
  transition: color var(--transition-fast);
}

a:hover {
  filter: brightness(1.2);
}

/* Scrollbar Personalizada */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}
::-webkit-scrollbar-track {
  background: var(--color-bg-base);
}
::-webkit-scrollbar-thumb {
  background: var(--color-border);
  border-radius: var(--radius-sm);
}
::-webkit-scrollbar-thumb:hover {
  background: var(--color-text-light);
}

/* Animações de Hover e Micro-interações */
.btn-animate {
  position: relative;
  overflow: hidden;
  transition: all var(--transition-fast);
}
.btn-animate:hover {
  transform: translateY(-1px);
  box-shadow: var(--shadow-md);
}
.btn-animate:active {
  transform: translateY(1px);
}

/* Animação Fade-In */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

.animate-fade-in {
  animation: fadeIn var(--transition-normal) forwards;
}

/* Glassmorphism Classes */
.glass {
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.1);
}

/* Tabelas Globais */
table {
  border-collapse: collapse;
  width: 100%;
}
th {
  padding: 10px 14px;
  text-align: left;
  font-size: 12px;
  font-weight: 700;
  color: var(--color-text-muted);
  background: var(--color-bg-card);
  border-bottom: 1px solid var(--color-border);
  letter-spacing: 0.4px;
  text-transform: uppercase;
}
td {
  padding: 11px 14px;
  font-size: 13px;
  color: var(--color-text-base);
  border-bottom: 1px solid var(--color-border);
  vertical-align: middle;
}
tr:last-child td {
  border-bottom: none;
}
tr:hover td {
  background: rgba(0, 0, 0, 0.02);
}
[data-theme="dark"] tr:hover td {
  background: rgba(255, 255, 255, 0.03);
}
code {
  font-family: 'Consolas', 'Monaco', monospace;
  font-size: 12px;
  background: rgba(0,0,0,0.06);
  padding: 2px 6px;
  border-radius: 3px;
  color: var(--color-text-muted);
}
[data-theme="dark"] code {
  background: rgba(255,255,255,0.08);
}

/* Premium Design Classes (Applied across the system) */
.premium-table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  background: var(--color-bg-base);
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
  border: 1px solid var(--color-border);
}
.premium-table thead {
  background-color: var(--color-bg-card);
}
.premium-table th {
  text-align: left;
  padding: 16px 20px;
  font-size: 12px;
  font-weight: 600;
  color: var(--color-text-light);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  border-bottom: 1px solid var(--color-border);
  white-space: nowrap;
}
.premium-table tbody tr {
  transition: background-color 0.2s ease;
}
.premium-table tbody tr:hover {
  background-color: var(--color-bg-card);
}
.premium-table td {
  padding: 16px 20px;
  font-size: 14px;
  color: var(--color-text-base);
  border-bottom: 1px solid var(--color-border);
  vertical-align: middle;
}
.premium-table tbody tr:last-child td {
  border-bottom: none;
}
.avatar-initials {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
  color: #1e40af;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: 600;
  border: 1px solid #bfdbfe;
  flex-shrink: 0;
  box-shadow: inset 0 2px 4px rgba(255,255,255,0.5);
}
.premium-btn-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8px;
  background-color: transparent;
  color: var(--color-text-light);
  border: 1px solid transparent;
  border-radius: 6px;
  cursor: pointer;
  transition: all 0.2s ease;
}
.premium-btn-icon:hover {
  background-color: var(--color-bg-card);
  color: var(--color-text-base);
  border-color: var(--color-border);
}
.premium-badge {
  display: inline-flex;
  align-items: center;
  padding: 4px 12px;
  border-radius: 9999px;
  font-size: 12px;
  font-weight: 600;
  line-height: 1.5;
}
.badge-ativo {
  background-color: rgba(16, 185, 129, 0.1);
  color: #059669;
}
.badge-inativo {
  background-color: rgba(239, 68, 68, 0.1);
  color: #DC2626;
}

/* ESTILOS DE IMPRESSÃO (Essencial para relatórios PDF e impressões oficiais) */
@media print {
  body {
    background: #FFFFFF !important;
    color: #000000 !important;
    font-size: 11pt !important;
  }

  .no-print {
    display: none !important;
  }

  .print-only {
    display: block !important;
  }

  /* Reset de margens e padding para impressão limpa */
  .app-container, .main-layout, .page-content {
    display: block !important;
    padding: 0 !important;
    margin: 0 !important;
    background: none !important;
    box-shadow: none !important;
    border: none !important;
    width: 100% !important;
  }

  .report-document {
    box-shadow: none !important;
    border: none !important;
    margin: 0 !important;
    padding: 0 !important;
    width: 100% !important;
    background: #FFFFFF !important;
    color: #000000 !important;
  }

  /* Cabeçalho do relatório deve ficar legível em preto e branco com o logo oficial */
  .report-header {
    border-bottom: 2px solid #000000 !important;
    margin-bottom: 25px !important;
    padding-bottom: 15px !important;
  }

  .report-title {
    color: #000000 !important;
  }

  .print-logo {
    max-height: 80px !important;
    filter: grayscale(100%) !important; /* Opção para impressão econômica P&B se preferível */
  }

  /* Evitar quebra de página dentro de tabelas ou blocos importantes */
  tr, blockquote, pre {
    page-break-inside: avoid;
  }

  .page-break {
    page-break-after: always;
  }
}

/* Classes de Arrastar (Draggable) */
.drag-handle {
  cursor: grab;
}
.drag-handle:active {
  cursor: grabbing;
}

/* Abas de Avaliação (Tab styling) */
.evaluation-tab {
  padding: 8px 16px;
  border: none;
  background: none;
  color: var(--color-text-muted);
  font-weight: 600;
  font-size: 14px;
  cursor: pointer;
  border-radius: 6px;
  transition: all 0.2s;
  white-space: nowrap;
  outline: none !important; /* Remove as marcas brancas/outline de foco */
  box-shadow: none !important;
}

.evaluation-tab:hover {
  background-color: rgba(255, 255, 255, 0.08);
  color: var(--color-text-base);
}

[data-theme="light"] .evaluation-tab:hover {
  background-color: rgba(0, 0, 0, 0.05);
}

.evaluation-tab.active {
  background-color: var(--color-primary);
  color: var(--color-accent) !important;
}

